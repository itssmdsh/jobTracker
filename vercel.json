{
  "version": 2,
  "builds": [
    {
      "src": "api/scrape.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/translate-links.js",
      "use": "@vercel/node"
    },
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "frontend/dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/scrape",
      "dest": "api/scrape.js"
    },
    {
      "src": "/api/translate-links",
      "dest": "api/translate-links.js"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
